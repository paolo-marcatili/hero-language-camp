  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../tools/sync-content-pack.mjs ../../content-packs/hy-eastern-it public/content-packs/hy-eastern-it && tsc --noEmit -p tsconfig.json && vite build && node ../../tools/generate-offline-service-worker.mjs dist",
